@font-face {
  font-family: 'Raleway';
  font-style: normal;
  font-weight: 400;
  src: url(fonts/Raleway.ttf) format('truetype');
}
@font-face {
  font-family: 'Raleway';
  font-style: normal;
  font-weight: 700;
  src: url(fonts/RalewayBold.ttf) format('truetype');
}

